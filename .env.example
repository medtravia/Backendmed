NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Comma-separated frontend origins. Do not use * in production.
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=false

# Generate a cryptographically random value of at least 32 characters.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1h

# Used only by: npm run admin:seed
ADMIN_NAME=MedTravia Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Brevo transactional email settings.
BREVO_API_KEY=replace-with-a-brevo-api-key
BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME=MedTravia
ADMIN_NOTIFICATION_EMAIL=admin@example.com

# Notification worker tuning. Defaults are safe for most deployments.
NOTIFICATION_POLL_INTERVAL_MS=5000
NOTIFICATION_LEASE_MS=60000
NOTIFICATION_MAX_ATTEMPTS=5
